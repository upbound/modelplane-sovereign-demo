[0.012044, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.012078, "o", "\u001b[1m\u001b[36m  5 \u00b7 Scale\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.014587, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 15:20 CEST\u001b[0m\r\n"]
[0.014628, "o", "\r\n"]
[0.016941, "o", "\u001b[35m\ud83d\udde3  Replicas are the scaling axis, and each one is a whole serving instance, placed on its own.\u001b[0m\r\n"]
[0.019443, "o", "\u001b[35m\ud83d\udde3  The scheduler spreads before it packs: a new replica goes to the eligible cluster with the \u001b[0m\r\n\u001b[35m    fewest of this model's replicas.\u001b[0m\r\n"]
[0.019672, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelreplica -l modelplane.ai/deployment=qwen-7b\u001b[0m\r\n"]
[0.049404, "o", "NAME            CLUSTER             SYNCED   READY   AGE\r\n"]
[0.04946, "o", "qwen-7b-ba0ae   aks-swedencentral   True     True    2m9s\r\n"]
[0.050999, "o", "\r\n"]
[0.083336, "m", "ENTER"]
[0.08337, "o", "\u001b[1m\u001b[33m\u25b8 Scale out: one more replica\u001b[0m\r\n"]
[0.114708, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team scale modeldeployment qwen-7b --replicas=2\u001b[0m\r\n"]
