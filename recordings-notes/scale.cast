[44.190497, "o", "  \u001b[32m\u2714\u001b[0m the gateway answers, with a replica on each cluster behind it\r\n"]
[44.190566, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 Scaling is one field. The new replica landed on the other provider.\u001b[0m\r\n\r\n"]
