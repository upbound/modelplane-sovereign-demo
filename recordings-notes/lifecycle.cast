{"version": 2, "width": 100, "height": 32, "timestamp": 1792502530, "env": {"TERM": "xterm-ghostty"}}
[0.011587, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011688, "o", "\r\n"]
[0.011703, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.01173, "o", "\u001b[1m\u001b[36m  8 \u00b7 Lifecycle\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.014231, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 15:22 CEST\u001b[0m\r\n"]
[0.014246, "o", "\r\n"]
[0.016897, "o", "\u001b[35m\ud83d\udde3  Every event in the table is an edit to an object, so it goes through Git and the API like \u001b[0m\r\n"]
[0.016933, "o", "\u001b[35m    any other change.\u001b[0m\r\n"]
[0.0195, "o", "\u001b[35m\ud83d\udde3  Maintenance is a field, not a runbook: a NoExecute taint moves the replicas off a cluster.\u001b[0m\r\n"]
[0.022192, "o", "\u001b[35m\ud83d\udde3  Modelplane refuses to delete a cluster something still runs on, and says what.\u001b[0m\r\n"]
[0.079013, "o", "\u001b[1m\u001b[33m\u25b8 New weights, engine or config: a second deployment, then shift weight here\u001b[0m\r\n"]
[0.079061, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelservice qwen-7b -o yaml\u001b[0m\r\n"]
[0.108658, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mendpoints\u001b[0m:\r\n"]
[0.108698, "o", "      - \u001b[36mname\u001b[0m: qwen-7b\r\n        \u001b[36mweight\u001b[0m: 1\r\n        \u001b[36mselector\u001b[0m:\r\n          \u001b[36mmatchLabels\u001b[0m:\r\n            \u001b[36mmodelplane.ai/deployment\u001b[0m: qwen-7b\r\n"]
[0.109197, "o", "\r\n"]
[0.109232, "o", "\u001b[1m\u001b[33m\u25b8 The rollout is one file: the new deployment and a second endpoint\u001b[0m\r\n"]
[0.109259, "o", "  \u001b[2mfrom examples/rollout-qwen-7b-v2.yaml:\u001b[0m\r\n"]
[0.14412, "o", "  ModelDeployment \u001b[36mqwen-7b-v2\u001b[0m: image vllm/vllm-openai:v0.23.0 \u001b[2m(qwen-7b runs v0.9.2)\u001b[0m\r\n"]
[0.144171, "o", "  ModelService \u001b[36mqwen-7b\u001b[0m:\r\n"]
[0.152225, "o", "    \u001b[36mendpoints\u001b[0m:\r\n      - \u001b[36mname\u001b[0m: qwen-7b\r\n"]
[0.152262, "o", "        \u001b[36mweight\u001b[0m: 9    \u001b[2m# 90% of requests\u001b[0m\r\n      - \u001b[36mname\u001b[0m: qwen-7b-v2\r\n        \u001b[36mweight\u001b[0m: 1    \u001b[2m# 10% of requests\u001b[0m\r\n"]
[0.152716, "o", "\u001b[1m\u001b[36m$ kubectl apply --dry-run=server \\\u001b[0m\r\n"]
[0.152728, "o", "\u001b[1m\u001b[36m    -f examples/rollout-qwen-7b-v2.yaml\u001b[0m\r\n"]
[0.152758, "o", "\u001b[2m  a server-side dry run: the API validates both and the EU policy admits qwen-7b-v2; nothing is created\u001b[0m\r\n"]
[0.195703, "o", "  modeldeployment.modelplane.ai/qwen-7b-v2 created (server dry run)\r\n"]
[0.246972, "o", "  modelservice.modelplane.ai/qwen-7b configured (server dry run)\r\n"]
[0.249571, "o", "\u001b[2m  Shift the weights as v2 proves itself; callers keep calling ml-team/qwen-7b throughout.\u001b[0m\r\n"]
[0.249623, "o", "\r\n"]
[0.249634, "m", "ENTER"]
[0.249639, "o", "\u001b[1m\u001b[33m\u25b8 Cluster upgrade: drain with a taint, change the version, remove the taint\u001b[0m\r\n\u001b[1m\u001b[36m$ kubectl get inferencecluster nebius-eu-north -o yaml\u001b[0m\r\n"]
[0.28009, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mtaints\u001b[0m: []\r\n"]
[0.280141, "o", "    \u001b[36mcluster\u001b[0m:\r\n      \u001b[36mnebius\u001b[0m:\r\n        \u001b[36mkubernetesVersion\u001b[0m: \"1.34\"\r\n      \u001b[36msource\u001b[0m: Nebius\r\n"]
[0.280621, "o", "\r\n"]
[0.280656, "m", "ENTER"]
[1.093351, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m a replica serving on each cluster first \u001b[2m(1s)\u001b[0m\r\n"]
[1.093513, "o", "\u001b[1m\u001b[33m\u25b8 Drain nebius-eu-north\u001b[0m\r\n"]
[1.132578, "o", "\u001b[1m\u001b[36m$ kubectl patch inferencecluster nebius-eu-north --type json \\\u001b[0m\r\n"]
[1.132624, "o", "\u001b[1m\u001b[36m    -p '[{\"op\": \"add\", \"path\": \"/spec/taints/-\", \"value\": {\"key\": \"modelplane.demo/drain\", \"effect\": \"NoExecute\"}}]'\u001b[0m\r\n"]
[1.226181, "o", "\r\u001b[K  \u001b[36m\u280b\u001b[0m replica removed from nebius-eu-north \u001b[2m0s\u001b[0m"]
[2.261068, "o", "\r\u001b[K  \u001b[36m\u2819\u001b[0m replica removed from nebius-eu-north \u001b[2m1s\u001b[0m"]
[3.302281, "o", "\r\u001b[K  \u001b[36m\u2839\u001b[0m replica removed from nebius-eu-north \u001b[2m2s\u001b[0m"]
[4.34675, "o", "\r\u001b[K  \u001b[36m\u2838\u001b[0m replica removed from nebius-eu-north \u001b[2m3s\u001b[0m"]
[5.420822, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m replica removed from nebius-eu-north \u001b[2m(4s)\u001b[0m\r\n"]
[5.420878, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelreplica -l modelplane.ai/deployment=qwen-7b\u001b[0m\r\n"]
[5.451877, "o", "NAME            CLUSTER             SYNCED   READY   AGE\r\n"]
[5.45192, "o", "qwen-7b-ba0ae   aks-swedencentral   True     True    4m24s\r\n"]
[5.510116, "o", "\u001b[2m  (no other cluster has a free GPU: running one short until capacity frees up)\u001b[0m\r\n"]
[5.691443, "o", "\r\u001b[K  \u001b[36m\u280b\u001b[0m gateway routes settled \u001b[2m0s\u001b[0m"]
[6.886427, "o", "\r\u001b[K  \u001b[36m\u2819\u001b[0m gateway routes settled \u001b[2m1s\u001b[0m"]
[8.596628, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m gateway routes settled \u001b[2m(3s)\u001b[0m\r\n"]
[8.596686, "o", "\u001b[2m  2 request(s) failed while the routes changed (issue #531)\u001b[0m\r\n"]
[8.66396, "o", "\u001b[1m\u001b[36m$ curl http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[8.664005, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n"]
[8.664021, "o", "\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n"]
[8.664031, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 16,\u001b[0m\r\n"]
[8.664058, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}]\u001b[0m\r\n"]
[8.664084, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[8.879955, "o", "  \u001b[32m\u2714\u001b[0m the gateway still serves from the other replica\r\n\r\n"]
[8.880018, "m", "ENTER"]
[8.880025, "o", "\u001b[1m\u001b[33m\u25b8 End of maintenance: remove the taint\u001b[0m\r\n"]
[8.91019, "o", "\u001b[1m\u001b[36m$ kubectl patch inferencecluster nebius-eu-north --type json \\\u001b[0m\r\n"]
[8.910238, "o", "\u001b[1m\u001b[36m    -p '[{\"op\": \"test\", \"path\": \"/spec/taints/0/key\", \"value\": \"modelplane.demo/drain\"}, {\"op\": \"remove\", \"path\": \"/spec/taints/0\"}]'\u001b[0m\r\n"]
[8.972478, "o", "  \u001b[32m\u2714\u001b[0m taint removed; a missing replica may land on nebius-eu-north again\r\n"]
[8.972529, "o", "\r\n\u001b[1m\u001b[33m\u25b8 Retire a cluster that's still in use\u001b[0m\r\n\u001b[1m\u001b[36m$ kubectl delete inferencecluster nebius-eu-north --dry-run=server\u001b[0m\r\n"]
[9.010626, "o", "  \u001b[31mrefused: ModelCaches use this InferenceCluster\u001b[0m\r\n"]
[9.010835, "o", "\r\n"]
[9.010868, "o", "\u001b[1m\u001b[32m\ud83d\udca1 Every lifecycle event is an edit to an object, and the destructive ones are guarded.\u001b[0m\r\n\r\n"]
