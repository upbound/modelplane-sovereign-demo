{"version": 2, "width": 100, "height": 32, "timestamp": 1792502648, "env": {"TERM": "xterm-ghostty"}}
[0.01075, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.010889, "o", "\r\n"]
[0.010906, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.010938, "o", "\u001b[1m\u001b[36m  10 \u00b7 Monitor\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.01296, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 15:24 CEST\u001b[0m\r\n"]
[0.012987, "o", "\r\n"]
[0.015143, "o", "\u001b[35m\ud83d\udde3  Modelplane ships no dashboards. Every cluster's collector exports one modelplane_* \u001b[0m\r\n\u001b[35m    vocabulary to a backend you run.\u001b[0m\r\n"]
[0.017604, "o", "\u001b[35m\ud83d\udde3  Here that's a Prometheus on the AKS cluster, and Grafana on this laptop.\u001b[0m\r\n"]
[0.04674, "o", "\u001b[1m\u001b[33m\u25b8 Where the fleet's metrics go \u001b[2m(one object, on the control plane)\u001b[0m\u001b[0m\r\n"]
[0.046798, "o", "\u001b[1m\u001b[36m$ kubectl get telemetrydestination fleet-prometheus -o yaml\u001b[0m\r\n"]
[0.106424, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mextensions\u001b[0m:\r\n      \u001b[36mbasicauth/prometheus\u001b[0m:\r\n        \u001b[36mclient_auth\u001b[0m:\r\n          \u001b[36mpassword\u001b[0m: ${env:PROMETHEUS_PASSWORD}\r\n          \u001b[36musername\u001b[0m: collector\r\n    \u001b[36msinks\u001b[0m:\r\n"]
[0.106475, "o", "      - \u001b[36mconfig\u001b[0m:\r\n          \u001b[36mauth\u001b[0m:\r\n            \u001b[36mauthenticator\u001b[0m: basicauth/prometheus\r\n          \u001b[36mtls\u001b[0m:\r\n            \u001b[36mca_file\u001b[0m: /etc/modelplane/telemetry/prometheus/PROMETHEUS_CA\r\n        \u001b[36mendpoint\u001b[0m: https://57.174.103.118:9090/api/v1/write\r\n        \u001b[36mname\u001b[0m: prometheus\r\n        \u001b[36msecretRef\u001b[0m:\r\n          \u001b[36mname\u001b[0m: fleet-prometheus\r\n        \u001b[36mtype\u001b[0m: prometheus_remote_write\r\n"]
[0.107015, "o", "\u001b[2m  Modelplane renders it into the collector on every cluster, and copies its Secret there.\u001b[0m\r\n\r\n"]
[0.10706, "m", "ENTER"]
[0.107085, "o", "\u001b[1m\u001b[33m\u25b8 Usage records from the gateway \u001b[2m(one JSON line per request)\u001b[0m\u001b[0m\r\n"]
[0.946321, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m gateway routes settled \u001b[2m(1s)\u001b[0m\r\n"]
[1.773305, "o", "\u001b[1m\u001b[36m$ curl -N http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[1.773358, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n"]
[1.773373, "o", "\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n\u001b[1m\u001b[36m      \"stream\": true,\u001b[0m\r\n"]
[1.773386, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 20,\u001b[0m\r\n"]
[1.773421, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"Say hello in one short sentence.\"}]\u001b[0m\r\n"]
[1.773446, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[2.006031, "o", "    Hello!"]
[2.00616, "o", "\r\n"]
[2.012642, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/aks-swedencentral.kubeconfig -n envoy-gateway-system \\\u001b[0m\r\n"]
[2.012667, "o", "\u001b[1m\u001b[36m    logs -l gateway.envoyproxy.io/owning-gateway-name=inference-gateway --all-containers --since=30m --tail=-1 \\\u001b[0m\r\n"]
[2.012685, "o", "\u001b[1m\u001b[36m    | grep '\"caller\":'\u001b[0m\r\n"]
[11.929203, "o", "\u001b[2m  the latest request from each caller, as a table:\u001b[0m\r\n"]
[11.929284, "o", "  \u001b[2mCALLER         MODEL                  IN    OUT STATUS       MS\u001b[0m\r\n"]
[12.704277, "o", "  demo           ml-team/qwen-7b        36      3    200       94\r\n"]
[12.704432, "o", "  chat-app       ml-team/qwen-7b        36     32    200      418\r\n"]
[12.705623, "o", "\u001b[2m  Who called is a log, not a metric label: callers are unbounded (issue #535).\u001b[0m\r\n"]
[12.705694, "o", "\r\n"]
[12.705705, "m", "ENTER"]
[12.705717, "o", "\u001b[1m\u001b[33m\u25b8 Both clusters, one vocabulary, in your Prometheus\u001b[0m\r\n"]
[12.725022, "o", "\u001b[1m\u001b[36m$ curl --cacert .secrets/monitoring/ca.crt -u grafana:\u2026 https://57.174.103.118:9090/api/v1/query \\\u001b[0m\r\n"]
[12.725079, "o", "\u001b[1m\u001b[36m    --data-urlencode 'query=count by (cluster) ({__name__=~\"modelplane_.+\"})'\u001b[0m\r\n  \u001b[2mCLUSTER                MODELPLANE_* SERIES\u001b[0m\r\n"]
[12.886169, "o", "  aks-swedencentral      291\r\n"]
[12.886241, "o", "  nebius-eu-north        185\r\n"]
[12.886791, "o", "\r\n"]
[12.886862, "o", "\u001b[2m  KV-cache use per replica, and GPU power, from the same store:\u001b[0m\r\n"]
[12.886893, "o", "  \u001b[2mCLUSTER                DEPLOYMENT   REPLICA  KV-CACHE\u001b[0m\r\n"]
[13.050227, "o", "  aks-swedencentral      qwen-7b      0        0.0%\r\n"]
[13.052237, "o", "  nebius-eu-north        qwen-7b      0        0.0%\r\n"]
[13.052464, "o", "  \u001b[2mCLUSTER                GPU POWER\u001b[0m\r\n"]
[13.217448, "o", "  aks-swedencentral      98 W\r\n"]
[13.217637, "o", "\r\n"]
[13.217664, "m", "ENTER"]
[13.217671, "o", "\u001b[1m\u001b[33m\u25b8 The dashboard\u001b[0m\r\n"]
[13.217682, "o", "\u001b[2m  The dashboard from this run is on the slide.\u001b[0m\r\n"]
[13.217693, "o", "\r\n"]
[13.217702, "o", "\u001b[1m\u001b[32m\ud83d\udca1 Every request leaves a record, in a backend you run.\u001b[0m\r\n\r\n"]
