[0.013192, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.013303, "o", "\r\n"]
[0.013341, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[36m  7 \u00b7 Resilience\u001b[0m\r\n"]
[0.013379, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.015374, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 15:21 CEST\u001b[0m\r\n\r\n"]
[0.017681, "o", "\u001b[35m\ud83d\udde3  Replicas spread across every eligible cluster. The gateway retries a failed request on \u001b[0m\r\n\u001b[35m    another replica and ejects one that keeps failing.\u001b[0m\r\n"]
[0.977754, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m a replica serving on each cluster \u001b[2m(1s)\u001b[0m\r\n"]
[1.018601, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m both replicas report Ready \u001b[2m(0s)\u001b[0m\r\n"]
[1.768823, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m gateway routes settled \u001b[2m(1s)\u001b[0m\r\n"]
[1.768883, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelreplica -l modelplane.ai/deployment=qwen-7b\u001b[0m\r\n"]
[1.797583, "o", "NAME            CLUSTER             SYNCED   READY   AGE\r\n"]
[1.797635, "o", "qwen-7b-b6b4e   nebius-eu-north     True     True    73s\r\nqwen-7b-ba0ae   aks-swedencentral   True     True    3m22s\r\n"]
[1.799243, "o", "\r\n"]
[1.799293, "m", "ENTER"]
[1.799307, "o", "\u001b[1m\u001b[33m\u25b8 Fail over: stop one replica while requests run\u001b[0m\r\n\u001b[2m  20 of these, one a second:\u001b[0m\r\n"]
[1.870375, "o", "\u001b[1m\u001b[36m$ curl http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[1.870422, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n"]
[1.870439, "o", "\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n"]
[1.870449, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 16,\u001b[0m\r\n"]
[1.870463, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}]\u001b[0m\r\n"]
[1.870485, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[3.014765, "o", "\u001b[32m\u25cf\u001b[0m"]
[4.301674, "o", "\u001b[32m\u25cf\u001b[0m"]
[5.577861, "o", "\u001b[32m\u25cf\u001b[0m"]
[6.87293, "o", "\u001b[32m\u25cf\u001b[0m"]
[7.878354, "o", "\r\n"]
[7.880946, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/nebius-eu-north.kubeconfig \\\u001b[0m\r\n"]
[7.881124, "o", "\u001b[1m\u001b[36m    -n mp-ml-team-51733 delete pod/qwen-7b-b6b4e-qwen-7b-dfe7f-7df9db956c-j9xjp --wait=false\u001b[0m\r\n"]
