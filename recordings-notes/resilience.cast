[31.982214, "o", "\r\n"]
[31.982326, "o", "  \u001b[32m\u2714\u001b[0m 20 requests, all 200\r\n"]
[31.982365, "o", "\u001b[2m  The deleted pod comes back on its own; the next beat waits for it.\u001b[0m\r\n"]
[31.982394, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 Lose a replica, keep serving: the gateway retries on the other provider.\u001b[0m\r\n"]
