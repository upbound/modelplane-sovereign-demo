{
  "uid": "modelplane-fleet",
  "title": "Modelplane fleet",
  "description": "The fleet's modelplane_* series, remote-written by every inference cluster's collector. Modelplane ships no dashboards; this one is the demo's.",
  "tags": ["modelplane"],
  "timezone": "browser",
  "editable": false,
  "graphTooltip": 1,
  "refresh": "10s",
  "schemaVersion": 39,
  "time": { "from": "now-15m", "to": "now" },
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Time to first token at the gateway",
      "description": "modelplane_frontend_ttft_seconds: what callers waited for the first streamed token, measured by the InferenceGateway. gen_ai_request_model is the deployment the request was routed to (issue #534).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "s", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "histogram_quantile(0.5, sum by (le, gen_ai_request_model) (rate(modelplane_frontend_ttft_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p50 · {{gen_ai_request_model}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le, gen_ai_request_model) (rate(modelplane_frontend_ttft_seconds_bucket[$__rate_interval])))",
          "legendFormat": "p95 · {{gen_ai_request_model}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Requests per second, by cluster",
      "description": "Requests each cluster's engines finished (modelplane_request_duration_seconds, from vLLM). With a replica on each cluster, this is the gateway's split across providers.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "reqps", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster) (rate(modelplane_request_duration_seconds_count[$__rate_interval]))",
          "legendFormat": "{{cluster}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Tokens per second, in and out",
      "description": "Sums of the prompt and generation token histograms (modelplane_request_input_tokens, modelplane_request_output_tokens), per cluster.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "custom": { "axisLabel": "tokens/s" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster) (rate(modelplane_request_input_tokens_sum[$__rate_interval]))",
          "legendFormat": "in · {{cluster}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster) (rate(modelplane_request_output_tokens_sum[$__rate_interval]))",
          "legendFormat": "out · {{cluster}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "KV-cache utilisation, per replica",
      "description": "modelplane_kv_cache_utilization_ratio, the max per replica: the saturation figure an alert would fire on.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "percentunit", "min": 0, "max": 1 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "max by (cluster, deployment, replica) (modelplane_kv_cache_utilization_ratio)",
          "legendFormat": "{{cluster}} · {{deployment}} #{{replica}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "GPU power, by cluster and node",
      "description": "modelplane_gpu_power_watts, from the GPU exporter the serving stack installs (DCGM_FI_DEV_POWER_USAGE).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "watt", "min": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster, node) (modelplane_gpu_power_watts)",
          "legendFormat": "{{cluster}} · {{node}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Requests running and waiting",
      "description": "modelplane_requests_running and modelplane_requests_waiting: in the engine and queued for it, per cluster.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
      "fieldConfig": { "defaults": { "unit": "short", "min": 0, "decimals": 0 }, "overrides": [] },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } },
      "targets": [
        {
          "refId": "A",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster) (modelplane_requests_running)",
          "legendFormat": "running · {{cluster}}"
        },
        {
          "refId": "B",
          "datasource": { "type": "prometheus", "uid": "fleet-prometheus" },
          "expr": "sum by (cluster) (modelplane_requests_waiting)",
          "legendFormat": "waiting · {{cluster}}"
        }
      ]
    }
  ]
}
