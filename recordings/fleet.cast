[0.011441, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011567, "o", "\r\n"]
[0.011585, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.0116, "o", "\u001b[1m\u001b[36m  2 \u00b7 Fleet\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.013808, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 15:25 CEST\u001b[0m\r\n\r\n"]
[0.013857, "o", "\u001b[1m\u001b[33m\u25b8 The hardware on offer: one InferenceClass per kind of node pool\u001b[0m\r\n"]
[0.013888, "o", "\u001b[1m\u001b[36m$ kubectl get inferenceclass \\\u001b[0m\r\n"]
[0.013908, "o", "\u001b[1m\u001b[36m    -o custom-columns=NAME:.metadata.name,DESCRIPTION:.spec.description,MEMORY:.spec.devices[0].capacity.memory.value\u001b[0m\r\n"]
[0.041144, "o", "  NAME      DESCRIPTION                                         MEMORY\r\n  a100-1x   AKS Standard_NC24ads_A100_v4, 1x NVIDIA A100 80GB   81920Mi\r\n  l40s-1x   Nebius gpu-l40s-a, 1x NVIDIA L40S 48GB              46068Mi\r\n"]
[0.042578, "o", "\r\n"]
[0.0426, "o", "\u001b[1m\u001b[33m\u25b8 The clusters that offer it\u001b[0m\r\n"]
[0.042625, "o", "\u001b[1m\u001b[36m$ kubectl get inferencecluster -L modelplane.ai/region,jurisdiction\u001b[0m\r\n"]
[0.069289, "o", "NAME                SOURCE   GATEWAY          SYNCED   READY   AGE    REGION          JURISDICTION\r\naks-swedencentral   AKS      57.174.100.174   True     True    173m   swedencentral   eu\r\n"]
[0.069352, "o", "nebius-eu-north     Nebius   89.169.122.75    True     True    173m   eu-north        eu\r\n"]
[0.07084, "o", "\u001b[2m  GATEWAY is each cluster's own mTLS entry point: the front door reaches its replicas through it.\u001b[0m\r\n"]
[0.070901, "o", "\r\n"]
[0.070914, "m", "ENTER"]
[0.100257, "o", "\u001b[1m\u001b[33m\u25b8 What one object became in Azure\u001b[0m\r\n"]
[0.100303, "o", "\u001b[1m\u001b[36m$ crossplane resource trace inferencecluster/aks-swedencentral\u001b[0m\r\n"]
[0.116638, "o", "  NAME                                                               SYNCED  READY  STATUS\r\n"]
[1.806066, "o", "  InferenceCluster/aks-swedencentral                                 True    True   Available\r\n"]
[1.806167, "o", "  \u251c\u2500 AKSCluster/aks-swedencentral                                    True    True   Available\r\n  \u2502  \u251c\u2500 ResourceGroup/modelplane-system-aks-swedencentral-aks-97ae4  True    True   Available\r\n  \u2502  \u251c\u2500 KubernetesClusterNodePool/aks-swedencentral-ac91c5656a3d     True    True   Available\r\n  \u2502  \u251c\u2500 KubernetesCluster/modelplane-system-aks-swedencentral-aks-\u2026  True    True   Available\r\n  \u2502  \u251c\u2500 Object/aks-swedencentral-2c3d6f1b5bc9                        True    True   Available\r\n  \u2502  \u251c\u2500 Subnet/aks-swedencentral-1740b5dddd51                        True    True   Available\r\n  \u2502  \u2514\u2500 VirtualNetwork/aks-swedencentral-561d405218c5                True    True   Available\r\n  \u251c\u2500 ServingStack/aks-swedencentral-serving-stack-0dd9b              True    True   Available\r\n  \u2502  \u2514\u2500 \u2026 15 Helm releases, 24 objects: the serving stack\r\n"]
[1.866785, "o", "\r\n"]
[1.866831, "m", "ENTER"]
[1.895453, "o", "\u001b[1m\u001b[33m\u25b8 The front door, on \u001b[2maks-swedencentral\u001b[0m\u001b[1m\u001b[33m: one per place requests enter\u001b[0m\r\n"]
[1.895496, "o", "\u001b[1m\u001b[36m$ kubectl get inferencegateway\u001b[0m\r\n"]
[1.922107, "o", "NAME   CLUSTER             ADDRESS           SYNCED   READY   AGE\r\n"]
[1.92215, "o", "eu     aks-swedencentral   172.160.123.204   True     True    174m\r\n"]
[1.952356, "o", "\u001b[2m  It serves ModelServices labelled jurisdiction=eu.\u001b[0m\r\n"]
[1.952392, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 The platform team is done: capacity is published once, on two providers. ML teams self-serve from here.\u001b[0m\r\n\r\n"]
