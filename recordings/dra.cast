[0.010061, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.010169, "o", "\r\n"]
[0.010182, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.010204, "o", "\u001b[1m\u001b[36m  1 \u00b7 DRA\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.01202, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:29 CEST\u001b[0m\r\n"]
[0.012031, "o", "\r\n"]
[0.067765, "o", "\u001b[1m\u001b[33m\u25b8 Before DRA: the node carries a label, the pod asks for a count\u001b[0m\r\n"]
[0.06841, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/aks-swedencentral.kubeconfig get nodes \\\u001b[0m\r\n"]
[0.068461, "o", "\u001b[1m\u001b[36m    -l nvidia.com/gpu.present=true -L nvidia.com/gpu.product\u001b[0m\r\n"]
[0.427593, "o", "  NAME                              GPU.PRODUCT\r\n  aks-gpua100-32161946-vmss000000   NVIDIA-A100-80GB-PCIe\r\n"]
[0.429228, "o", "\r\n"]
[0.429285, "m", "ENTER"]
[0.429293, "o", "\u001b[1m\u001b[33m\u25b8 With DRA: the driver publishes each device\u001b[0m\r\n"]
[0.429878, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/aks-swedencentral.kubeconfig get resourceslices -o yaml\u001b[0m\r\n"]
[0.429892, "o", "\u001b[2m  the GPU driver's slice, abridged:\u001b[0m\r\n"]
[0.749847, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mdriver\u001b[0m: gpu.nvidia.com\r\n"]
[0.749897, "o", "    \u001b[36mnodeName\u001b[0m: aks-gpua100-32161946-vmss000000\r\n    \u001b[36mdevices\u001b[0m:\r\n      - \u001b[36mname\u001b[0m: gpu-0\r\n        \u001b[36mattributes\u001b[0m:\r\n          \u001b[36marchitecture\u001b[0m:\r\n            \u001b[36mstring\u001b[0m: Ampere\r\n          \u001b[36mcudaComputeCapability\u001b[0m:\r\n            \u001b[36mversion\u001b[0m: 8.0.0\r\n          \u001b[36mproductName\u001b[0m:\r\n            \u001b[36mstring\u001b[0m: NVIDIA A100 80GB PCIe\r\n        \u001b[36mcapacity\u001b[0m:\r\n          \u001b[36mmemory\u001b[0m:\r\n            \u001b[36mvalue\u001b[0m: 80Gi\r\n"]
[0.750499, "o", "\r\n"]
[0.75054, "m", "ENTER"]
[0.750556, "o", "\u001b[1m\u001b[33m\u25b8 The engine pod claims a device by what it is\u001b[0m\r\n"]
[1.055459, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/aks-swedencentral.kubeconfig \\\u001b[0m\r\n"]
[1.055518, "o", "\u001b[1m\u001b[36m    -n mp-ml-team-51733 get resourceclaim \\\u001b[0m\r\n\u001b[1m\u001b[36m    qwen-7b-ba0ae-qwen-7b-b0315-568c78c558-zxtxn-devices-6fbgf -o yaml\u001b[0m\r\n"]
[1.357476, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mrequest\u001b[0m:\r\n      \u001b[36mdeviceClassName\u001b[0m: gpu.nvidia.com\r\n"]
[1.35753, "o", "      \u001b[36mselectors\u001b[0m:\r\n        - |\r\n          device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"14Gi\")) >= 0\r\n  \u001b[36mstatus\u001b[0m:\r\n    \u001b[36mallocated\u001b[0m:\r\n      - \u001b[36mdriver\u001b[0m: gpu.nvidia.com\r\n        \u001b[36mpool\u001b[0m: aks-gpua100-32161946-vmss000000\r\n        \u001b[36mdevice\u001b[0m: gpu-0\r\n"]
[1.358199, "o", "\r\n"]
[1.358254, "m", "ENTER"]
[1.358277, "o", "\u001b[1m\u001b[33m\u25b8 Modelplane checks the same CEL one level up, against each InferenceClass\u001b[0m\r\n"]
[1.392564, "o", "\u001b[1m\u001b[36m$ kubectl get inferenceclass a100-1x -o yaml\u001b[0m\r\n"]
[1.424298, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mdevices\u001b[0m:\r\n      - \u001b[36mname\u001b[0m: gpu\r\n        \u001b[36mclaim\u001b[0m: DRA\r\n        \u001b[36mdriver\u001b[0m: gpu.nvidia.com\r\n"]
[1.424351, "o", "        \u001b[36mattributes\u001b[0m:\r\n          \u001b[36marchitecture\u001b[0m:\r\n            \u001b[36mstring\u001b[0m: Ampere\r\n          \u001b[36mcudaComputeCapability\u001b[0m:\r\n            \u001b[36mversion\u001b[0m: 8.0.0\r\n        \u001b[36mcapacity\u001b[0m:\r\n          \u001b[36mmemory\u001b[0m:\r\n            \u001b[36mvalue\u001b[0m: 81920Mi\r\n"]
[1.456007, "o", "\u001b[2m  The deployment's selector: device.capacity[\"gpu.nvidia.com\"].memory.compareTo(quantity(\"14Gi\")) >= 0\u001b[0m\r\n"]
[1.456058, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 The same CEL decides twice: Modelplane picks the cluster and pool, DRA binds the GPU.\u001b[0m\r\n\r\n"]
