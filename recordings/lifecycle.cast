[0.010805, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.010913, "o", "\r\n"]
[0.010929, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.010957, "o", "\u001b[1m\u001b[36m  8 \u00b7 Lifecycle\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.013345, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:37 CEST\u001b[0m\r\n"]
[0.01338, "o", "\r\n"]
[0.071885, "o", "\u001b[1m\u001b[33m\u25b8 New weights, engine or config: a second deployment, then shift weight here\u001b[0m\r\n"]
[0.071937, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelservice qwen-7b -o yaml\u001b[0m\r\n"]
[0.100871, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mendpoints\u001b[0m:\r\n      - \u001b[36mname\u001b[0m: qwen-7b\r\n        \u001b[36mweight\u001b[0m: 1\r\n        \u001b[36mselector\u001b[0m:\r\n          \u001b[36mmatchLabels\u001b[0m:\r\n"]
[0.100935, "o", "            \u001b[36mmodelplane.ai/deployment\u001b[0m: qwen-7b\r\n"]
[0.101416, "o", "\r\n"]
[0.101443, "o", "\u001b[1m\u001b[33m\u25b8 The rollout is one file: the new deployment and a second endpoint\u001b[0m\r\n"]
[0.101455, "o", "  \u001b[2mfrom examples/rollout-qwen-7b-v2.yaml:\u001b[0m\r\n"]
[0.135152, "o", "  ModelDeployment \u001b[36mqwen-7b-v2\u001b[0m: image vllm/vllm-openai:v0.23.0 \u001b[2m(qwen-7b runs v0.9.2)\u001b[0m\r\n"]
[0.135201, "o", "  ModelService \u001b[36mqwen-7b\u001b[0m:\r\n"]
[0.140971, "o", "    \u001b[36mendpoints\u001b[0m:\r\n      - \u001b[36mname\u001b[0m: qwen-7b\r\n        \u001b[36mweight\u001b[0m: 9    \u001b[2m# 90% of requests\u001b[0m\r\n"]
[0.141009, "o", "      - \u001b[36mname\u001b[0m: qwen-7b-v2\r\n        \u001b[36mweight\u001b[0m: 1    \u001b[2m# 10% of requests\u001b[0m\r\n"]
[0.141496, "o", "\u001b[1m\u001b[36m$ kubectl apply --dry-run=server \\\u001b[0m\r\n"]
[0.14151, "o", "\u001b[1m\u001b[36m    -f examples/rollout-qwen-7b-v2.yaml\u001b[0m\r\n"]
[0.141533, "o", "\u001b[2m  a server-side dry run: the API validates both and the EU policy admits qwen-7b-v2; nothing is created\u001b[0m\r\n"]
[0.180814, "o", "  modeldeployment.modelplane.ai/qwen-7b-v2 created (server dry run)\r\n"]
[0.221279, "o", "  modelservice.modelplane.ai/qwen-7b configured (server dry run)\r\n"]
[0.223493, "o", "\u001b[2m  Shift the weights as v2 proves itself; callers keep calling ml-team/qwen-7b throughout.\u001b[0m\r\n"]
[0.223534, "o", "\r\n"]
[0.223541, "m", "ENTER"]
[0.223546, "o", "\u001b[1m\u001b[33m\u25b8 Cluster upgrade: drain with a taint, change the version, remove the taint\u001b[0m\r\n\u001b[1m\u001b[36m$ kubectl get inferencecluster nebius-eu-north -o yaml\u001b[0m\r\n"]
[0.254838, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mtaints\u001b[0m: []\r\n    \u001b[36mcluster\u001b[0m:\r\n      \u001b[36mnebius\u001b[0m:\r\n        \u001b[36mkubernetesVersion\u001b[0m: \"1.34\"\r\n"]
[0.25488, "o", "      \u001b[36msource\u001b[0m: Nebius\r\n"]
[0.255328, "o", "\r\n"]
[0.255369, "m", "ENTER"]
[1.118927, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m a replica serving on each cluster first \u001b[2m(1s)\u001b[0m\r\n"]
[1.118987, "o", "\u001b[1m\u001b[33m\u25b8 Drain nebius-eu-north\u001b[0m\r\n"]
[1.15271, "o", "\u001b[1m\u001b[36m$ kubectl patch inferencecluster nebius-eu-north --type json \\\u001b[0m\r\n"]
[1.152769, "o", "\u001b[1m\u001b[36m    -p '[{\"op\": \"add\", \"path\": \"/spec/taints/-\", \"value\": {\"key\": \"modelplane.demo/drain\", \"effect\": \"NoExecute\"}}]'\u001b[0m\r\n"]
[1.249537, "o", "\r\u001b[K  \u001b[36m\u280b\u001b[0m replica removed from nebius-eu-north \u001b[2m0s\u001b[0m"]
[2.289914, "o", "\r\u001b[K  \u001b[36m\u2819\u001b[0m replica removed from nebius-eu-north \u001b[2m1s\u001b[0m"]
[3.325057, "o", "\r\u001b[K  \u001b[36m\u2839\u001b[0m replica removed from nebius-eu-north \u001b[2m2s\u001b[0m"]
[4.35904, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m replica removed from nebius-eu-north \u001b[2m(3s)\u001b[0m\r\n"]
[4.359087, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelreplica -l modelplane.ai/deployment=qwen-7b\u001b[0m\r\n"]
[4.387691, "o", "NAME            CLUSTER             SYNCED   READY   AGE\r\n"]
[4.387741, "o", "qwen-7b-ba0ae   aks-swedencentral   True     True    7m31s\r\n"]
[4.448175, "o", "\u001b[2m  (no other cluster has a free GPU: running one short until capacity frees up)\u001b[0m\r\n"]
[5.106819, "o", "\r\u001b[K  \u001b[36m\u280b\u001b[0m gateway routes settled \u001b[2m0s\u001b[0m"]
[6.294149, "o", "\r\u001b[K  \u001b[36m\u2819\u001b[0m gateway routes settled \u001b[2m1s\u001b[0m"]
[8.00361, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m gateway routes settled \u001b[2m(3s)\u001b[0m\r\n"]
[8.003668, "o", "\u001b[2m  2 request(s) failed while the routes changed (issue #531)\u001b[0m\r\n"]
[8.074421, "o", "\u001b[1m\u001b[36m$ curl http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[8.074474, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n"]
[8.074496, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 16,\u001b[0m\r\n"]
[8.074509, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"ping\"}]\u001b[0m\r\n"]
[8.074522, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[8.308437, "o", "  \u001b[32m\u2714\u001b[0m the gateway still serves from the other replica\r\n\r\n"]
[8.308503, "m", "ENTER"]
[8.308509, "o", "\u001b[1m\u001b[33m\u25b8 End of maintenance: remove the taint\u001b[0m\r\n"]
[8.339032, "o", "\u001b[1m\u001b[36m$ kubectl patch inferencecluster nebius-eu-north --type json \\\u001b[0m\r\n"]
[8.339078, "o", "\u001b[1m\u001b[36m    -p '[{\"op\": \"test\", \"path\": \"/spec/taints/0/key\", \"value\": \"modelplane.demo/drain\"}, {\"op\": \"remove\", \"path\": \"/spec/taints/0\"}]'\u001b[0m\r\n"]
[8.400744, "o", "  \u001b[32m\u2714\u001b[0m taint removed; a missing replica may land on nebius-eu-north again\r\n"]
[8.400797, "o", "\r\n\u001b[1m\u001b[33m\u25b8 Retire a cluster that's still in use\u001b[0m\r\n\u001b[1m\u001b[36m$ kubectl delete inferencecluster nebius-eu-north --dry-run=server\u001b[0m\r\n"]
[8.440585, "o", "  \u001b[31mrefused: ModelCaches use this InferenceCluster\u001b[0m\r\n"]
[8.44075, "o", "\r\n"]
[8.440776, "o", "\u001b[1m\u001b[32m\ud83d\udca1 Every lifecycle event is an edit to an object, and the destructive ones are guarded.\u001b[0m\r\n\r\n"]
