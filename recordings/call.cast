[0.011243, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011374, "o", "\r\n"]
[0.011402, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[36m  6 \u00b7 Call\u001b[0m\r\n"]
[0.011429, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.013399, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:33 CEST\u001b[0m\r\n"]
[0.013429, "o", "\r\n"]
[0.013449, "o", "\u001b[1m\u001b[36m$ kubectl get inferencegateway eu\u001b[0m\r\n"]
[0.040849, "o", "NAME   CLUSTER             ADDRESS           SYNCED   READY   AGE\r\n"]
[0.040899, "o", "eu     aks-swedencentral   172.160.123.204   True     True    122m\r\n"]
[0.042384, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modelservice qwen-7b\u001b[0m\r\n"]
[0.06931, "o", "NAME      MODEL             SYNCED   READY   AGE\r\n"]
[0.069375, "o", "qwen-7b   ml-team/qwen-7b   True     True    27m\r\n"]
[0.071138, "o", "\r\n"]
[0.099732, "o", "\u001b[1m\u001b[33m\u25b8 No key, no model\u001b[0m\r\n"]
[0.128523, "o", "\u001b[1m\u001b[36m$ curl http://172.160.123.204/v1/models\u001b[0m\r\n"]
[0.247146, "o", "  \u001b[31mHTTP 401\u001b[0m\r\n"]
[0.2472, "o", "\r\n\u001b[1m\u001b[33m\u25b8 With a key\u001b[0m\r\n"]
[0.280216, "o", "\u001b[1m\u001b[36m$ curl http://172.160.123.204/v1/models \\\u001b[0m\r\n"]
[0.280275, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026'\u001b[0m\r\n"]
[0.410811, "o", "  ml-team/qwen-7b\r\n"]
[0.411037, "o", "\r\n"]
[0.411102, "m", "ENTER"]
[0.411122, "o", "\u001b[1m\u001b[33m\u25b8 A chat completion, streamed\u001b[0m\r\n"]
[0.481092, "o", "\u001b[1m\u001b[36m$ curl -N http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[0.481142, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n"]
[0.481158, "o", "\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n"]
[0.481168, "o", "\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n"]
[0.481196, "o", "\u001b[1m\u001b[36m      \"stream\": true,\u001b[0m\r\n"]
[0.481221, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 80,\u001b[0m\r\n"]
[0.481239, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"In two sentences, what does an inference gateway do?\"}]\u001b[0m\r\n"]
[0.481255, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[1.436418, "o", "    An inference gateway acts as a middleware that receives \r\n    requests for machine learning or AI model predictions, then \r\n"]
[1.436486, "o", "    forwards those requests to the appropriate backend model \r\n    service, and finally returns the model's predictions back to \r\n    the requester. It helps manage and route inference requests \r\n    efficiently, ensuring low latency and high throughput for model \r\n"]
[1.436618, "o", "    predictions."]
[1.436854, "o", "\r\n"]
[1.436886, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 One OpenAI-compatible endpoint. Callers never see a cluster.\u001b[0m\r\n\r\n"]
