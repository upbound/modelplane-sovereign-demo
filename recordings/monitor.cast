{"version": 2, "width": 100, "height": 32, "timestamp": 1792500014, "env": {"TERM": "xterm-ghostty"}}
[0.011617, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011732, "o", "\r\n"]
[0.011751, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n\u001b[1m\u001b[36m  10 \u00b7 Monitor\u001b[0m\r\n"]
[0.011764, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.014288, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:40 CEST\u001b[0m\r\n"]
[0.014314, "o", "\r\n"]
[0.042888, "o", "\u001b[1m\u001b[33m\u25b8 Where the fleet's metrics go \u001b[2m(one object, on the control plane)\u001b[0m\u001b[0m\r\n"]
[0.04294, "o", "\u001b[1m\u001b[36m$ kubectl get telemetrydestination fleet-prometheus -o yaml\u001b[0m\r\n"]
[0.101744, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mextensions\u001b[0m:\r\n"]
[0.101798, "o", "      \u001b[36mbasicauth/prometheus\u001b[0m:\r\n        \u001b[36mclient_auth\u001b[0m:\r\n          \u001b[36mpassword\u001b[0m: ${env:PROMETHEUS_PASSWORD}\r\n          \u001b[36musername\u001b[0m: collector\r\n    \u001b[36msinks\u001b[0m:\r\n      - \u001b[36mconfig\u001b[0m:\r\n          \u001b[36mauth\u001b[0m:\r\n            \u001b[36mauthenticator\u001b[0m: basicauth/prometheus\r\n          \u001b[36mtls\u001b[0m:\r\n            \u001b[36mca_file\u001b[0m: /etc/modelplane/telemetry/prometheus/PROMETHEUS_CA\r\n        \u001b[36mendpoint\u001b[0m: https://57.174.103.118:9090/api/v1/write\r\n        \u001b[36mname\u001b[0m: prometheus\r\n        \u001b[36msecretRef\u001b[0m:\r\n          \u001b[36mname\u001b[0m: fleet-prometheus\r\n        \u001b[36mtype\u001b[0m: prometheus_remote_write\r\n"]
[0.102338, "o", "\u001b[2m  Modelplane renders it into the collector on every cluster, and copies its Secret there.\u001b[0m\r\n\r\n"]
[0.102392, "m", "ENTER"]
[0.102414, "o", "\u001b[1m\u001b[33m\u25b8 Usage records from the gateway \u001b[2m(one JSON line per request)\u001b[0m\u001b[0m\r\n"]
[1.14995, "o", "\r\u001b[K  \u001b[32m\u2714\u001b[0m gateway routes settled \u001b[2m(1s)\u001b[0m\r\n"]
[1.948436, "o", "\u001b[1m\u001b[36m$ curl -N http://172.160.123.204/v1/chat/completions \\\u001b[0m\r\n"]
[1.948479, "o", "\u001b[1m\u001b[36m    -H 'Authorization: Bearer sk-\u2026' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -H 'Content-Type: application/json' \\\u001b[0m\r\n\u001b[1m\u001b[36m    -d '{\u001b[0m\r\n"]
[1.948495, "o", "\u001b[1m\u001b[36m      \"model\": \"ml-team/qwen-7b\",\u001b[0m\r\n"]
[1.948507, "o", "\u001b[1m\u001b[36m      \"stream\": true,\u001b[0m\r\n"]
[1.948522, "o", "\u001b[1m\u001b[36m      \"max_tokens\": 20,\u001b[0m\r\n"]
[1.948547, "o", "\u001b[1m\u001b[36m      \"messages\": [{\"role\": \"user\", \"content\": \"Say hello in one short sentence.\"}]\u001b[0m\r\n"]
[1.948562, "o", "\u001b[1m\u001b[36m    }'\u001b[0m\r\n"]
[2.17661, "o", "    Hello!"]
[2.176803, "o", "\r\n"]
[2.183248, "o", "\u001b[1m\u001b[36m$ kubectl --kubeconfig .secrets/aks-swedencentral.kubeconfig -n envoy-gateway-system \\\u001b[0m\r\n"]
[2.1833, "o", "\u001b[1m\u001b[36m    logs -l gateway.envoyproxy.io/owning-gateway-name=inference-gateway --all-containers --since=30m --tail=-1 \\\u001b[0m\r\n\u001b[1m\u001b[36m    | grep '\"caller\":'\u001b[0m\r\n"]
[6.554345, "o", "\u001b[2m  the latest request from each caller, as a table:\u001b[0m\r\n"]
[6.554496, "o", "  \u001b[2mCALLER         MODEL                  IN    OUT STATUS       MS\u001b[0m\r\n"]
[7.362642, "o", "  demo           ml-team/qwen-7b        36      3    200       92\r\n"]
[7.36272, "o", "  chat-app       ml-team/qwen-7b        36     29    200      385\r\n"]
[7.36324, "o", "\u001b[2m  Who called is a log, not a metric label: callers are unbounded (issue #535).\u001b[0m\r\n"]
[7.363261, "o", "\r\n"]
[7.363295, "m", "ENTER"]
[7.363313, "o", "\u001b[1m\u001b[33m\u25b8 Both clusters, one vocabulary, in your Prometheus\u001b[0m\r\n"]
[7.37875, "o", "\u001b[1m\u001b[36m$ curl --cacert .secrets/monitoring/ca.crt -u grafana:\u2026 https://57.174.103.118:9090/api/v1/query \\\u001b[0m\r\n"]
[7.37878, "o", "\u001b[1m\u001b[36m    --data-urlencode 'query=count by (cluster) ({__name__=~\"modelplane_.+\"})'\u001b[0m\r\n  \u001b[2mCLUSTER                MODELPLANE_* SERIES\u001b[0m\r\n"]
[7.545534, "o", "  aks-swedencentral      291\r\n"]
[7.545582, "o", "  nebius-eu-north        178\r\n"]
[7.545865, "o", "\r\n"]
[7.545903, "o", "\u001b[2m  KV-cache use per replica, and GPU power, from the same store:\u001b[0m\r\n"]
[7.545931, "o", "  \u001b[2mCLUSTER                DEPLOYMENT   REPLICA  KV-CACHE\u001b[0m\r\n"]
[7.708346, "o", "  aks-swedencentral      qwen-7b      0        0.0%\r\n"]
[7.711194, "o", "  nebius-eu-north        qwen-7b      0        0.0%\r\n"]
[7.711482, "o", "  \u001b[2mCLUSTER                GPU POWER\u001b[0m\r\n"]
[7.872379, "o", "  aks-swedencentral      98 W\r\n"]
[7.872636, "o", "\r\n"]
[7.872677, "m", "ENTER"]
[7.872696, "o", "\u001b[1m\u001b[33m\u25b8 The dashboard\u001b[0m\r\n\u001b[2m  The dashboard from this run is on the slide.\u001b[0m\r\n\r\n"]
[7.872717, "o", "\u001b[1m\u001b[32m\ud83d\udca1 Every request leaves a record, in a backend you run.\u001b[0m\r\n\r\n"]
