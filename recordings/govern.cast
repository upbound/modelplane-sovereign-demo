{"version": 2, "width": 100, "height": 32, "timestamp": 1792499548, "env": {"TERM": "xterm-ghostty"}}
[0.011294, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.011423, "o", "\r\n"]
[0.01144, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.01147, "o", "\u001b[1m\u001b[36m  4 \u00b7 Govern\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.013505, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:32 CEST\u001b[0m\r\n\r\n"]
[0.013569, "o", "\u001b[1m\u001b[33m\u25b8 Where this model may run\u001b[0m\r\n"]
[0.013597, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modeldeployment qwen-7b -o yaml\u001b[0m\r\n"]
[0.043175, "o", "  \u001b[36mspec\u001b[0m:\r\n    \u001b[36mtemplate\u001b[0m:\r\n      \u001b[36mspec\u001b[0m:\r\n        \u001b[36mclusterSelector\u001b[0m:\r\n          \u001b[36mmatchLabels\u001b[0m:\r\n"]
[0.043224, "o", "            \u001b[36mjurisdiction\u001b[0m: eu\r\n        \u001b[36mmodelCacheRef\u001b[0m:\r\n          \u001b[36mname\u001b[0m: qwen-7b\r\n"]
[0.043679, "o", "\r\n"]
[0.043718, "o", "\u001b[1m\u001b[33m\u25b8 The rule, in the API\u001b[0m\r\n"]
[0.043746, "o", "\u001b[1m\u001b[36m$ kubectl get validatingadmissionpolicy eu-only-model-deployments -o yaml\u001b[0m\r\n"]
[0.073299, "o", "  \u001b[36mhas(object.spec.template.spec.clusterSelector) &&\u001b[0m\r\n  \u001b[36mhas(object.spec.template.spec.clusterSelector.matchLabels) &&\u001b[0m\r\n  \u001b[36m'jurisdiction' in object.spec.template.spec.clusterSelector.matchLabels &&\u001b[0m\r\n  \u001b[36mobject.spec.template.spec.clusterSelector.matchLabels['jurisdiction'] == 'eu'\u001b[0m\r\n"]
[0.073492, "o", "\r\n"]
[0.073541, "m", "ENTER"]
[0.073552, "o", "\u001b[1m\u001b[33m\u25b8 A team tries to deploy without the EU selector\u001b[0m\r\n"]
[0.073566, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team apply --dry-run=server \\\u001b[0m\r\n"]
[0.073576, "o", "\u001b[1m\u001b[36m    -f policies/test/qwen-anywhere.yaml\u001b[0m\r\n"]
[0.0736, "o", "\u001b[2m  a server-side dry run: admission runs, nothing is stored\u001b[0m\r\n"]
[0.114832, "o", "\u001b[31m  denied by ValidatingAdmissionPolicy eu-only-model-deployments:\u001b[0m\r\n"]
[0.117431, "o", "  \u001b[31mModelDeployments in this namespace must set \u001b[0m\r\n  \u001b[31mspec.template.spec.clusterSelector.matchLabels.jurisdiction: eu.\u001b[0m\r\n"]
[0.117624, "o", "\u001b[2m  The policy binds to namespaces labelled jurisdiction=eu, such as ml-team.\u001b[0m\r\n"]
[0.118974, "o", "\r\n\u001b[1m\u001b[32m\ud83d\udca1 Jurisdiction is a label. Enforcement is policy in the API.\u001b[0m\r\n\r\n"]
