[0.0133, "o", "\u001b[3J\u001b[H\u001b[2J"]
[0.013406, "o", "\r\n"]
[0.013422, "o", "\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.013457, "o", "\u001b[1m\u001b[36m  9 \u00b7 Oversight\u001b[0m\r\n\u001b[1m\u001b[36m\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u001b[0m\r\n"]
[0.01623, "o", "\u001b[2m  recorded run \u00b7 Tue 20 Oct 2026, 14:39 CEST\u001b[0m\r\n"]
[0.016248, "o", "\r\n"]
[0.016282, "o", "\u001b[1m\u001b[33m\u25b8 Who changed what \u001b[2m(metadata.managedFields)\u001b[0m\u001b[0m\r\n"]
[0.016305, "o", "\u001b[1m\u001b[36m$ kubectl -n ml-team get modeldeployment qwen-7b --show-managed-fields -o yaml\u001b[0m\r\n"]
[0.047163, "o", "  \u001b[32mcontroller \u001b[0m apiextensions.crossplane.io/composite  status\r\n"]
[0.04723, "o", "  \u001b[32mcontroller \u001b[0m crossplane                             status\r\n  \u001b[36mperson     \u001b[0m kubectl-client-side-apply              spec.template\r\n"]
[0.047494, "o", "\u001b[2m  With GitOps, the person's row becomes Argo CD or Flux: the pull request is the approval.\u001b[0m\r\n"]
[0.047526, "o", "\r\n"]
[0.047537, "m", "ENTER"]
[0.04756, "o", "\u001b[1m\u001b[33m\u25b8 Who may do what in ml-team\u001b[0m\r\n\u001b[1m\u001b[36m$ kubectl -n ml-team get rolebinding ml-team-view gitops-edit -o wide\u001b[0m\r\n"]
[0.077157, "o", "NAME           ROLE                          AGE   USERS   GROUPS   SERVICEACCOUNTS\r\n"]
[0.077205, "o", "ml-team-view   ClusterRole/crossplane-view   33m   alice            \r\ngitops-edit    ClusterRole/crossplane-edit   33m                    argocd/argocd-application-controller\r\n"]
[0.07881, "o", "\r\n"]
[0.078829, "o", "\u001b[1m\u001b[33m\u25b8 A team member tries to scale up by hand\u001b[0m\r\n"]
[0.078879, "o", "\u001b[1m\u001b[36m$ kubectl --as=alice -n ml-team patch modeldeployment qwen-7b \\\u001b[0m\r\n"]
[0.078892, "o", "\u001b[1m\u001b[36m    --type merge -p '{\"spec\":{\"replicas\":2}}' --dry-run=server\u001b[0m\r\n"]
[0.114988, "o", "  \u001b[31mforbidden: User \"alice\" cannot patch resource \"modeldeployments\" \u001b[0m\r\n  \u001b[31min API group \"modelplane.ai\" in the namespace \"ml-team\"\u001b[0m\r\n"]
[0.115332, "o", "\u001b[2m  alice can still see it:\u001b[0m\r\n"]
[0.11536, "o", "\u001b[1m\u001b[36m$ kubectl --as=alice -n ml-team get modeldeployment\u001b[0m\r\n"]
[0.143256, "o", "NAME      REPLICAS   SYNCED   READY   AGE\r\n"]
[0.14331, "o", "qwen-7b   2          True     True    33m\r\n"]
[0.145088, "o", "\r\n"]
[0.145127, "m", "ENTER"]
[0.145132, "o", "\u001b[1m\u001b[33m\u25b8 The pipeline can\u001b[0m\r\n"]
[0.14515, "o", "\u001b[1m\u001b[36m$ kubectl auth can-i patch modeldeployments.modelplane.ai -n ml-team \\\u001b[0m\r\n"]
[0.14516, "o", "\u001b[1m\u001b[36m    --as=system:serviceaccount:argocd:argocd-application-controller\u001b[0m\r\n"]
[0.188787, "o", "  \u001b[32myes\u001b[0m\r\n"]
[0.188837, "o", "\u001b[2m  The change is the pull request: Git holds who proposed it and who approved it.\u001b[0m\r\n\r\n\u001b[1m\u001b[32m\ud83d\udca1 People propose in Git, a reviewer approves, the pipeline applies.\u001b[0m\r\n\r\n"]
